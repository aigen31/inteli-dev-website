# config.toml.example — пример конфигурации приложения inteli-dev.ru.
# Скопируйте в `config.toml` и заполните. ⚠️ config.toml НЕ коммитится в Git.
# Секреты (API key, токены ботов, admin token) задаются через env vars (.env).

[server]
host = "0.0.0.0"
port = 8080
# Публичный адрес сайта: из него собираются абсолютные ссылки в RSS, sitemap и
# событиях кросспостинга. Отдельно от host/port, т.к. приложение слушает
# 0.0.0.0:8080 за обратным прокси. Или PUBLIC_URL env.
public_url = "https://inteli-dev.ru"
read_timeout_ms = 5000
write_timeout_ms = 10000

[database]
path = "data/chats.db"        # или DB_PATH env (в контейнере: /data/chats.db)

[cache]
enabled = true
ttl_seconds = 3600            # TTL кэша ответов LLM (in-memory; Redis — этап P7)

[openviking]
base_url = "http://viking:1933/mcp"
timeout_seconds = 5
read_timeout_seconds = 5

[llm]
provider = "deepseek"
base_url = "https://api.deepseek.com/v1"
model = "deepseek-chat"
# api_key — читается из env LLM_API_KEY, НЕ храните его здесь.
max_tokens = 600              # потолок выходных токенов
temperature = 0.7
context_top_k = 4             # сколько фрагментов памяти подмешивать в промпт
context_snippet_chars = 400   # сколько символов брать из каждого фрагмента
context_max_chars = 1600      # жёсткий бюджет RAG-контекста
context_min_score = 0.35      # порог релевантности

[telegram]
bot_token = ""                # или TELEGRAM_BOT_TOKEN env
admin_chat_id = 0             # или TELEGRAM_ADMIN_CHAT_ID env

[vk]
oauth_token = ""              # или VK_OAUTH_TOKEN env
admin_user_id = 0             # или VK_ADMIN_USER_ID env

[admin]
token = ""                    # или ADMIN_TOKEN env (Bearer-аутентификация)

[settings_bot]
# Бот для управления настройками сайта. Отдельный токен: у бота заявок прав
# менять сайт нет. Пока не заданы все три значения, эндпоинт выключен (404).
token = ""            # или SETTINGS_BOT_TOKEN env
admin_id = 0          # или SETTINGS_BOT_ADMIN_ID env
webhook_secret = ""   # или SETTINGS_BOT_WEBHOOK_SECRET env

[github]
# Блок «Открытый код» на главной + ссылка на профиль в шапке.
# Публичные данные (репозитории, языки, контрибуции) читаются анонимно, поэтому
# блок работает без токена. Токен (env GITHUB_TOKEN) нужен только чтобы поднять
# лимит GitHub API с 60 до 5000 запросов в час и брать контрибуции из GraphQL,
# а не разбором HTML. См. docs/github-stats.md.
#
# `username` управляет и блоком, и иконкой в шапке: она публикуется при старте
# из конфига и не зависит от того, удалось ли получить статистику. Пустой логин
# убирает и блок, и ссылку.
username = "aigen31"
# `enabled` выключает только блок статистики. Ссылка в шапке при этом остаётся —
# её прячет пустой `username`.
enabled = true
cache_ttl_seconds = 21600     # 6 часов: статистика меняется медленно
show_stars = false            # звёзды/подписчики прячем, пока числа маленькие

[ratelimit]
max_requests_per_minute = 10  # технический антифлуд (все типы запросов)
window_seconds = 60

[integrations]
# Кросспостинг. Сайт — источник правды: публикация статьи создаёт событие в
# таблице article_events (transactional outbox), а n8n забирает его из
# GET /api/integrations/outbox и подтверждает через POST .../ack.
# Пока ключ не задан, эндпоинты выключены (отвечают 404). См. docs/articles.md.
n8n_api_key = ""              # или N8N_API_KEY env (секрет)
outbox_batch_limit = 50       # сколько событий отдавать за один запрос

[limits]
# Пользовательские лимиты. Те же числа попадают в UI (maxlength, подсказки)
# и в серверную валидацию — источник правды один.
chat_message_max_chars = 500
llm_requests_per_hour = 3     # AI-ответов на посетителя в час (preset не считаются)
lead_name_max_chars = 80
lead_message_max_chars = 1000
lead_phone_max_chars = 20

[logging]
level = "info"                # или RUST_LOG env

[security]
ip_hash_algorithm = "sha256"
