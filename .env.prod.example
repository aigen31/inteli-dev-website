# .env.prod.example — шаблон продакшен-окружения.
# Скопируйте в `.env.prod` и заполните реальными значениями на сервере.
# ⚠️ `.env.prod` НЕ коммитится в Git и не попадает в образ (.dockerignore).

# --- Образ приложения (docker-compose.prod.yml) ---
APP_IMAGE=inteli-dev.ru:latest
APP_VERSION=0.1.0

# --- Логи ---
RUST_LOG=warn

# --- LLM (DeepSeek V4 / OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- VK ---
VK_OAUTH_TOKEN=
VK_ADMIN_USER_ID=

# --- Admin panel ---
# Сгенерировать: openssl rand -base64 32
ADMIN_TOKEN=
