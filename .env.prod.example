# .env.prod.example — шаблон продакшен-окружения.
# Скопируйте в `.env.prod` и заполните реальными значениями на сервере.
# ⚠️ `.env.prod` НЕ коммитится в Git и не попадает в образ (.dockerignore).

# --- Образ приложения (docker-compose.prod.yml) ---
APP_IMAGE=inteli-dev.ru:latest
APP_VERSION=0.1.0

# --- Логи ---
RUST_LOG=warn

# --- Публичный адрес сайта ---
# Из него собираются абсолютные ссылки в RSS, sitemap и событиях кросспостинга.
PUBLIC_URL=https://inteli-dev.ru

# --- Кросспостинг (n8n) ---
# Сайт — источник правды: публикация статьи создаёт событие в transactional
# outbox. n8n забирает его: GET /api/integrations/outbox с заголовком
# X-Api-Key, затем POST /api/integrations/outbox/ack. Пустой ключ выключает
# фид целиком (404). Сгенерировать: openssl rand -hex 32
N8N_API_KEY=

# --- SEO: IndexNow ---
# Сайт сам сообщает Яндексу и Bing о новых, изменённых и удалённых страницах:
# публикация статьи создаёт уведомление, а ключ отдаётся из корня как
# /{ключ}.txt. Ключ не секретный, но задаётся здесь, чтобы включать протокол
# без пересборки образа. Пустое значение выключает IndexNow.
# Сгенерировать: openssl rand -hex 16
INDEXNOW_KEY=

# --- LLM (DeepSeek V4 / OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- VK ---
VK_OAUTH_TOKEN=
VK_ADMIN_USER_ID=

# --- Admin panel ---
# Сгенерировать: openssl rand -base64 32
ADMIN_TOKEN=

# --- Бот настроек сайта (отдельный бот, не тот, что шлёт заявки) ---
# Владелец меняет статус занятости из Telegram: /available, /busy, /full,
# /projects, /slot, /when и inline-кнопки.
SETTINGS_BOT_TOKEN=
SETTINGS_BOT_ADMIN_ID=
# Секрет вебхука. Сгенерировать: openssl rand -hex 32
# То же значение уходит в setWebhook (scripts/set-telegram-webhook.sh).
SETTINGS_BOT_WEBHOOK_SECRET=

# --- GitHub (блок «Открытый код» на главной) ---
# Опционально: публичные данные читаются анонимно. Токен поднимает лимит
# GitHub API с 60 до 5000 запросов/час на IP и включает GraphQL для
# контрибуций. Classic PAT без scope достаточно.
GITHUB_TOKEN=
# Пусто = логин из config/config.prod.toml.
GITHUB_USERNAME=
